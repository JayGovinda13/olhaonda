# STAGING (homologação). Copie para .env.staging para rodar `npm run dev:staging` / `build:staging`.
# Na Vercel, cadastre estas variáveis no ambiente "Preview" restrito à branch `staging`.
VITE_APP_ENV=staging

# Projeto Supabase de STAGING (separado do de produção)
VITE_SUPABASE_URL=https://<ref-staging>.supabase.co
VITE_SUPABASE_ANON_KEY=

VITE_PLATFORM_FEE_PERCENT=20
# Em staging os anúncios nunca carregam AdSense (evita tráfego inválido)
VITE_ADS_CONTACT=mailto:anuncie@olhaonda.com.br
