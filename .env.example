# Copie para .env.local e preencha. Tudo aqui é público (vai para o navegador).

# Supabase (fórum, contas e fotos). Sem isso o site roda em modo demonstração.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Comissão exibida ao fotógrafo (a cobrada de fato é PLATFORM_FEE_PERCENT na Edge Function)
VITE_PLATFORM_FEE_PERCENT=20

# Publicidade: Google AdSense (opcional). Venda direta: edite HOUSE_ADS em src/components/AdSlot.tsx
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_LEADERBOARD=
VITE_ADSENSE_SLOT_RECTANGLE=
VITE_ADSENSE_SLOT_INLINE=
VITE_ADS_CONTACT=mailto:anuncie@olhaonda.com.br

# Open-Meteo comercial (opcional; sem chave usa a API gratuita não comercial)
VITE_OPEN_METEO_API_KEY=
