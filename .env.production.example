# PRODUÇÃO. Na Vercel, cadastre no ambiente "Production" (branch `main`).
VITE_APP_ENV=production

# Recursos: em produção, por enquanto, só a previsão. Mude para true para ligar.
VITE_FEATURE_FORUM=false
VITE_FEATURE_PHOTOS=false

# Picos: "sp" = litoral de São Paulo com onda (padrão em produção); "all" = todos
VITE_SPOT_SCOPE=sp

VITE_SUPABASE_URL=https://<ref-producao>.supabase.co
VITE_SUPABASE_ANON_KEY=

VITE_PLATFORM_FEE_PERCENT=20
# vazio = usa o ID padrão de src/config/adsenseId.ts (ca-pub-5358034925788308)
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_LEADERBOARD=
VITE_ADSENSE_SLOT_RECTANGLE=
VITE_ADSENSE_SLOT_INLINE=
VITE_ADS_CONTACT=mailto:anuncie@olhaonda.com
VITE_PRIVACY_CONTACT=privacidade@olhaonda.com
VITE_CONTACT_EMAIL=contato@olhaonda.com
# Endereço canônico (sitemap, robots e link canonical). Padrão: https://olhaonda.com
VITE_SITE_URL=https://olhaonda.com
VITE_OPEN_METEO_API_KEY=
