# PRODUÇÃO. Na Vercel, cadastre no ambiente "Production" (branch `main`).
VITE_APP_ENV=production

# Recursos: em produção, por enquanto, só a previsão. Mude para true para ligar.
VITE_FEATURE_FORUM=false
VITE_FEATURE_PHOTOS=false

# Picos: "baixada" = só praias com onda da Baixada Santista (padrão em produção); "all" = todos
VITE_SPOT_SCOPE=baixada

VITE_SUPABASE_URL=https://<ref-producao>.supabase.co
VITE_SUPABASE_ANON_KEY=

VITE_PLATFORM_FEE_PERCENT=20
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_LEADERBOARD=
VITE_ADSENSE_SLOT_RECTANGLE=
VITE_ADSENSE_SLOT_INLINE=
VITE_ADS_CONTACT=mailto:anuncie@olhaonda.com.br
VITE_OPEN_METEO_API_KEY=
