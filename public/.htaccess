# OlhaOnda na hospedagem Hostinger (Apache/LiteSpeed)

# HTTPS e domínio sem "www"
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# SPA: endereços como /privacidade ou /forum/123 abrem o index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Cache: arquivos com hash no nome podem ficar um ano; o index.html nunca fica velho
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|woff2|png|jpg|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|ads\.txt|robots\.txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Tipo correto para o worker do mapa (.mjs)
AddType text/javascript .mjs
