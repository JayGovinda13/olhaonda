# A página inicial nunca fica guardada: assim cada visita pega a versão nova do site e os arquivos certos.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Os arquivos em /assets têm o conteúdo no nome (hash): podem ficar guardados para sempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
